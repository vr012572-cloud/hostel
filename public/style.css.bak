*{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}body{font-family:Inter,sans-serif;background:#07110f;color:#edf8f2;overflow-x:hidden}.bg-orb{position:fixed;width:420px;height:420px;border-radius:50%;filter:blur(100px);opacity:.16;z-index:-1}.orb1{background:#00e887;top:-180px;left:-120px}.orb2{background:#6d5dfc;right:-150px;bottom:10%;opacity:.13}.nav{position:fixed;top:0;left:0;right:0;height:78px;display:flex;align-items:center;justify-content:space-between;padding:0 6%;z-index:10;background:rgba(7,17,15,.72);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,.07)}.brand{display:flex;align-items:center;gap:11px}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#16e38a,#09a85e);font-weight:900;color:#04120c}.brand b{display:block;font-size:13px;letter-spacing:1px}.brand small{font-size:9px;color:#8ea79b}.links{display:flex;gap:28px}.links a{color:#a9beb4;text-decoration:none;font-size:13px}.links a:hover{color:#6effb1}.nav-btn,.secondary{border:1px solid #315047;background:#10231e;color:#dff9ec;padding:11px 17px;border-radius:12px;cursor:pointer}.hero{min-height:820px;padding:150px 8% 100px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:50px}.pill,.eyebrow{color:#5dffac;font-size:11px;font-weight:800;letter-spacing:2px}.pill{display:inline-block;padding:9px 13px;border:1px solid #214b3b;border-radius:30px;background:#0b2119;margin-bottom:25px}.hero h1{font-family:"Space Grotesk";font-size:clamp(46px,6vw,78px);line-height:.98;letter-spacing:-3px;max-width:720px}.hero h1 span,h2 span{color:#58f5a2}.hero-copy>p{color:#9bb2a8;max-width:620px;line-height:1.8;margin:25px 0}.hero-actions{display:flex;gap:12px;margin:25px 0 35px}.primary{display:inline-block;border:0;background:linear-gradient(135deg,#5dffac,#16bd72);color:#03120b;text-decoration:none;font-weight:800;padding:14px 20px;border-radius:13px;cursor:pointer}.stats{display:flex;gap:40px}.stats b{display:block;font-size:25px}.stats span{font-size:11px;color:#7e958b}.hero-visual{height:500px;display:grid;place-items:center;position:relative;perspective:1000px}.cube{width:240px;height:240px;position:relative;transform-style:preserve-3d;transform:rotateX(-18deg) rotateY(-35deg);animation:float 5s ease-in-out infinite}.cube-face{position:absolute;width:240px;height:240px;border:1px solid rgba(120,255,190,.45);background:linear-gradient(135deg,rgba(27,97,68,.75),rgba(10,34,27,.88));display:grid;place-items:center;font-size:42px;font-weight:900;box-shadow:inset 0 0 50px rgba(65,255,160,.1)}.front{transform:translateZ(120px)}.back{transform:rotateY(180deg) translateZ(120px)}.right{transform:rotateY(90deg) translateZ(120px)}.left{transform:rotateY(-90deg) translateZ(120px)}.top-face{transform:rotateX(90deg) translateZ(120px)}.bottom-face{transform:rotateX(-90deg) translateZ(120px)}@keyframes float{50%{transform:rotateX(-18deg) rotateY(325deg) translateY(-20px)}}.glass-card{position:absolute;padding:14px 18px;border:1px solid rgba(255,255,255,.1);background:rgba(20,42,35,.72);backdrop-filter:blur(16px);border-radius:17px;display:flex;gap:12px;align-items:center;box-shadow:0 20px 60px #0008}.glass-card span{font-size:26px}.glass-card b{display:block;font-size:12px}.glass-card small{font-size:10px;color:#87a196}.floating-card.top{top:55px;right:0}.floating-card.bottom{bottom:55px;left:0}.section{padding:105px 8%}.section-head{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:45px}.section-head h2,.contact-section h2{font-family:"Space Grotesk";font-size:clamp(36px,4vw,58px);line-height:1.02;margin-top:12px;letter-spacing:-2px}.section-head>p{max-width:350px;color:#82998f;line-height:1.7}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature{padding:30px;border:1px solid #1b342c;background:linear-gradient(145deg,#0d211a,#091713);border-radius:22px;transition:.3s}.feature:hover{transform:translateY(-7px);border-color:#3ee895}.feature-icon{font-size:28px;margin-bottom:22px}.feature h3{font-size:17px;margin-bottom:9px}.feature p,.facility p{color:#7f978c;font-size:13px;line-height:1.7}.dark-section{background:#091512;border-top:1px solid #152b24;border-bottom:1px solid #152b24}.facility-grid{display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:14px}.facility{min-height:210px;border:1px solid #203c32;border-radius:22px;padding:28px;background:radial-gradient(circle at top right,#153c2c,#0b1c16);transition:.3s}.facility:hover{transform:translateY(-5px)}.facility.large{grid-row:span 2;min-height:434px;display:flex;align-items:end;background:linear-gradient(145deg,#103b2a,#091713)}.facility>span{font-size:34px}.facility h3{margin:20px 0 8px;font-family:"Space Grotesk";font-size:23px}.gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.gallery-item{height:270px;border-radius:22px;overflow:hidden;position:relative;border:1px solid #1d3b30}.gallery-item img{width:100%;height:100%;object-fit:cover;transition:.5s}.gallery-item:hover img{transform:scale(1.08)}.gallery-item div{position:absolute;bottom:0;left:0;right:0;padding:45px 20px 18px;background:linear-gradient(transparent,#000b);font-weight:700}.contact-section{margin:70px 8%;padding:70px;border-radius:30px;border:1px solid #25453a;background:linear-gradient(120deg,#10271f,#0a1814);display:grid;grid-template-columns:1fr 1fr;gap:70px}.contact-section p{color:#8ca49a;margin-top:25px}.contact-section form{display:grid;gap:12px}.contact-section input,.contact-section textarea{width:100%;background:#07110e;border:1px solid #28463c;color:white;padding:15px;border-radius:12px;outline:none;font:inherit}.contact-section input:focus,.contact-section textarea:focus{border-color:#4be99a}.contact-section button{width:max-content}.contact-section #formMsg{font-size:12px;color:#61f2a6}.contact-section #formMsg.error{color:#ff8b8b}footer{padding:35px 8%;border-top:1px solid #172d26;display:flex;justify-content:space-between;color:#70877d;font-size:12px}footer span{margin-left:12px}footer strong{color:#5dffac}@media(max-width:850px){.links{display:none}.hero{grid-template-columns:1fr;padding-top:120px}.hero-visual{height:430px}.feature-grid,.gallery-grid{grid-template-columns:1fr 1fr}.facility-grid{grid-template-columns:1fr 1fr}.facility.large{grid-row:auto;min-height:300px}.contact-section{grid-template-columns:1fr;padding:40px;gap:35px}.section-head{align-items:start;flex-direction:column}}@media(max-width:550px){.hero h1{font-size:46px}.stats{gap:18px}.feature-grid,.gallery-grid,.facility-grid{grid-template-columns:1fr}.floating-card.top{right:-10px}.floating-card.bottom{left:-10px}.section{padding:80px 6%}.contact-section{margin:40px 6%;padding:30px}footer{flex-direction:column;gap:15px}}
.mess-section{background:linear-gradient(180deg,#081510,#07110e)}
.mess-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.mess-card{border:1px solid #234238;border-radius:22px;overflow:hidden;background:#0b1b15;box-shadow:0 15px 45px #0005;transition:.3s}
.mess-card:hover{transform:translateY(-7px);border-color:#48ed9b}
.mess-card img{display:block;width:100%;height:250px;object-fit:cover}
.mess-card div{padding:15px 17px;font-weight:700;font-size:13px}
.mess-card div span{margin-right:9px}
.facility-link{display:block;margin-top:14px;color:#5dffac;font-size:11px;font-weight:700}
@media(max-width:850px){.mess-grid{grid-template-columns:1fr 1fr}}
@media(max-width:550px){.mess-grid{grid-template-columns:1fr}.mess-card img{height:230px}}

.celebrations-section{background:linear-gradient(180deg,#091712,#06100d);}
.celebration-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
.celebration-card{border:1px solid #24463a;border-radius:22px;overflow:hidden;background:#0a1914;transition:.3s;box-shadow:0 16px 45px #0005;}
.celebration-card:hover{transform:translateY(-7px);border-color:#58f5a2;}
.celebration-card img{display:block;width:100%;height:310px;object-fit:cover;transition:.5s;}
.celebration-card:hover img{transform:scale(1.05);}
.celebration-card div{padding:16px 17px 18px;}
.celebration-card span{margin-right:9px;}
.celebration-card b{font-size:13px;}
.celebration-card small{display:block;color:#7f978c;font-size:11px;margin-top:7px;}
@media(max-width:1000px){.celebration-grid{grid-template-columns:1fr 1fr;}}
@media(max-width:550px){.celebration-grid{grid-template-columns:1fr;}.celebration-card img{height:270px;}}

.sports-showcase{display:grid;grid-template-columns:1.45fr .8fr;gap:28px;align-items:center}
.sports-photo{height:470px;border-radius:26px;overflow:hidden;border:1px solid #25493b;background:#07110e;box-shadow:0 25px 70px #0007}
.sports-photo img{width:100%;height:100%;object-fit:cover;transition:.5s}
.sports-photo:hover img{transform:scale(1.035)}
.sports-info h3{font-family:"Space Grotesk";font-size:28px;margin-bottom:10px}
.sports-info>p{color:#82998f;line-height:1.7;margin-bottom:22px}
.sports-list{display:grid;gap:0}
.sports-list>div{display:grid;grid-template-columns:42px 1fr;column-gap:10px;padding:17px 0;border-top:1px solid #1c382e}
.sports-list span{grid-row:span 2;font-size:25px}
.sports-list b{font-size:15px}
.sports-list small{color:#7f978c;font-size:12px;line-height:1.5;margin-top:4px}
.facility-link{display:block;color:#5dffac;margin-top:14px;font-size:11px}
@media(max-width:850px){.sports-showcase{grid-template-columns:1fr}.sports-photo{height:360px}}
@media(max-width:550px){.sports-photo{height:280px}}
